# ==============================================================
# GreenCrate Environment Configuration
# ==============================================================

# Your email settings (e.g. Gmail, Outlook, SendGrid)
# To use Gmail:
# 1. Enable 2-Step Verification in Google Account.
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Fill in your Gmail and App Password below.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password

# Email address where admin wants to receive customer feedback notifications
FEEDBACK_NOTIFICATION_EMAIL=your-email@gmail.com

# Default from address shown in outgoing emails
DEFAULT_FROM_EMAIL=your-email@gmail.com

# AI chatbot (set this in the environment where the chatbot runs)
GEMINI_API_KEY=your-google-ai-api-key
